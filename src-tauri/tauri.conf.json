{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pokemon Team Builder",
  "version": "0.22.1",
  "identifier": "com.mernhil.pokemonteambuilder",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Pokémon Team Builder",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2M0YxQzdGMEJBNkREOEIKUldTTDNhWUxmeHcvUmdxVFJwcGx0STNxcTlVdG9vUDA1RXlWMlVmMDBibzhRTk5TZzVvSGhJaVAK",
      "endpoints": ["https://github.com/Mernhil/pokemon-team-builder/releases/latest/download/latest.json"]
    }
  }
}
