# Security headers for the Cloudflare Workers deploy (wrangler.jsonc serves ./dist; Workers static
# assets read this file from the output directory and never serve it). Mirrors the desktop CSP in
# src-tauri/tauri.conf.json: everything is self-hosted (the Meta tab's refresh fetches this site's own meta/latest.json).
# Inline styles are needed for React `style` props.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
